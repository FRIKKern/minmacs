{
  "id": "pnpm-metadata",
  "title": "pnpm metadata cache",
  "group": "js",
  "class": "cache",
  "paths": [
    "~/Library/Caches/pnpm"
  ],
  "advice": "pnpm store prune",
  "ownerNote": "global",
