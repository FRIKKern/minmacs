{
  "id": "user-logs",
  "title": "Old logs",
  "group": "system",
  "class": "cache",
  "paths": [
    "~/Library/Logs/*.log.old.*",
    "~/Library/Logs/*/*.log.old.*"
  ],
  "ownerNote": "folder name",
