{
  "id": "vscode",
  "title": "VS Code caches",
  "group": "editors",
  "class": "cache",
  "paths": [
    "~/Library/Application Support/Code/{Cache,CachedData,logs}"
  ],
  "ownerNote": "workspaceStorage/*/workspace.json (guess)",
